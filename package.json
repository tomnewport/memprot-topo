{
  "name": "memprot2d",
  "version": "0.0.0",
  "description": "A browser-based SVG web component for visualising membrane protein 2D topology",
  "type": "module",
  "main": "dist/memprot2d.cjs",
  "module": "dist/memprot2d.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/memprot2d.js",
      "require": "./dist/memprot2d.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prebuild:e2e": "tsx scripts/prebuild-demo.ts --from examples --out test/e2e/.generated/demo-data.ts",
    "prebuild:gallery": "node scripts/prebuild-gallery.mjs",
    "prebuild:demo": "tsx scripts/prebuild-demo.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.44.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.3",
    "@semantic-release/npm": "^12.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.0",
    "semantic-release": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
